      {
        "regex": "new RegExp('\\b(no|nah|n|nay)\\b', 'i')",
        "next": "change_app_5"
      }
    ]
  },
  {
    "id": "change_app_skills",
    "type": "prompt",
    "prompt": "Q: What experience do you have?",
    "responses": [
      {
        "regex": "const regex = /(?:(\\d+\\+?\\s*(?:years|months))\\s+of\\s+experience\\s+(?:in|with)\\s+([\\w\\s\\/&-]+))|(?:experience\\s+(?:in|with)\\s+([\\w\\s\\/&-]+))|(?:worked\\s+(?:in|on|with)\\s+([\\w\\s\\/&-]+))|(?:skills?\\s+in\\s+([\\w\\s\\/&-]+))/gi;",
        "extract": "match",
        "saveAs": "app_skills",
        "next": "change_app_5"
      }
    ]
  },
  {
    "id": "change_app_5",
